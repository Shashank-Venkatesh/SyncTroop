# Backend Environment Variables Template
# Copy to .env and fill in with your actual values

# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Atlas Connection
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGO_URI=

# JWT Secret (generate a secure random string - at least 32 characters)
JWT_SECRET=

# Client URL (frontend domain - used for CORS)
CLIENT_URL=

# Backend URL (informational, used for documentation)
BACKEND_URL_PROD=
